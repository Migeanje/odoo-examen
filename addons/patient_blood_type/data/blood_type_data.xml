<?xml version="1.0" encoding="utf-8"?>
<!-- noupdate="1": datos iniciales que el usuario puede modificar sin que una
     actualización del módulo los sobreescriba. -->
<odoo noupdate="1">

    <record id="blood_type_o_positive" model="patient.blood.type">
        <field name="name">O+</field>
        <field name="sequence">1</field>
    </record>
    <record id="blood_type_o_negative" model="patient.blood.type">
        <field name="name">O-</field>
        <field name="sequence">2</field>
    </record>
    <record id="blood_type_a_positive" model="patient.blood.type">
        <field name="name">A+</field>
        <field name="sequence">3</field>
    </record>
    <record id="blood_type_a_negative" model="patient.blood.type">
        <field name="name">A-</field>
        <field name="sequence">4</field>
    </record>
    <record id="blood_type_b_positive" model="patient.blood.type">
        <field name="name">B+</field>
        <field name="sequence">5</field>
    </record>
    <record id="blood_type_b_negative" model="patient.blood.type">
        <field name="name">B-</field>
        <field name="sequence">6</field>
    </record>
    <record id="blood_type_ab_positive" model="patient.blood.type">
        <field name="name">AB+</field>
        <field name="sequence">7</field>
    </record>
    <record id="blood_type_ab_negative" model="patient.blood.type">
        <field name="name">AB-</field>
        <field name="sequence">8</field>
    </record>

</odoo>
