<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="patient_blood_type.InvoiceDateDialog">
        <Dialog size="'md'" title="'Edicion fecha de factura'">
            <h1 class="mb-3">FECHA DE FACTURA</h1>
            <input type="date"
                   class="form-control"
                   t-att-value="state.invoiceDate"
                   t-on-input="onDateInput"
                   t-att-disabled="state.saving"/>
            <t t-set-slot="footer">
                <button class="btn btn-primary"
                        t-on-click="onSave"
                        t-att-disabled="state.saving">Guardar</button>
                <button class="btn btn-secondary"
                        t-on-click="onCancel"
                        t-att-disabled="state.saving">Cancel</button>
            </t>
        </Dialog>
    </t>

</templates>
